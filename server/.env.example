NODE_ENV=development
HOST=127.0.0.1
PORT=4000
API_PREFIX=/api/v1
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
TRUST_PROXY=false
LOG_LEVEL=info

MONGODB_URI=mongodb://127.0.0.1:27017/sourcesense

# Required for original document storage
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Required for document embeddings
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# "local" calculates cosine similarity in Node.js and works with a standard
# local MongoDB/Compass connection. Use "mongodb" only with Vector Search.
VECTOR_SEARCH_MODE=local
VECTOR_SEARCH_INDEX=vector_index
VECTOR_SEARCH_LIMIT=5
VECTOR_SEARCH_MIN_SCORE=0.2
DOCUMENT_MAX_FILE_SIZE_MB=10

JWT_SECRET=replace-this-with-at-least-32-random-characters
JWT_EXPIRES_IN=7d
JWT_COOKIE_NAME=sourcesense_session
JWT_COOKIE_MAX_AGE_MS=604800000

# Optional dedicated key for encrypting third-party tokens at rest.
# Falls back to JWT_SECRET when unset.
TOKEN_ENCRYPTION_KEY=

RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=20

# Frontend origin used for OAuth redirects after GitHub callback
FRONTEND_URL=http://127.0.0.1:5173

# Public API base URL used for GitHub webhook callbacks
# For local/dev, expose this with a tunnel (ngrok/cloudflare) when testing auto-review
APP_PUBLIC_URL=http://127.0.0.1:4000

# GitHub OAuth App credentials
# Callback must match the Authorization callback URL configured in GitHub
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://127.0.0.1:4000/api/v1/github/callback
GITHUB_WEBHOOK_SECRET=

# Knowledge base background worker (Mongo job queue)
# Keep true in the API process for local/dev, or false and run `npm run worker`
KNOWLEDGE_WORKER_ENABLED=true
KNOWLEDGE_WORKER_POLL_MS=2000

# Auto PR review background worker (Mongo job queue)
REVIEW_WORKER_ENABLED=true
REVIEW_WORKER_POLL_MS=2000

# Used only by npm run seed:admin
ADMIN_NAME=SourceSense Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-password
