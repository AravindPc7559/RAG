NODE_ENV=development
HOST=127.0.0.1
PORT=4000
API_PREFIX=/api/v1
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
TRUST_PROXY=false
LOG_LEVEL=info

MONGODB_URI=mongodb://127.0.0.1:27017/rag

JWT_SECRET=replace-this-with-at-least-32-random-characters
JWT_EXPIRES_IN=7d
JWT_COOKIE_NAME=rag_session
JWT_COOKIE_MAX_AGE_MS=604800000

RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=20

# Used only by npm run seed:admin
ADMIN_NAME=Workspace Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-password
